# Base MySQL (MariaDB) de ejemplo para Sqoop. Los datos viven en el volumen
# (/hadoop/mysql), asi sobreviven a recrear el contenedor. Configurada chica:
# alcanza para practicar y ocupa ~100 MB de memoria.
[mysqld]
user                    = mysql
datadir                 = /hadoop/mysql
bind-address            = 0.0.0.0
port                    = 3306
log_error               = /var/log/mysql/error.log
innodb_buffer_pool_size = 32M
innodb_log_file_size    = 16M
key_buffer_size         = 8M
max_connections         = 30
performance_schema      = OFF
skip-name-resolve
local_infile            = 1

# Solo el cliente 'mysql' (no mysqladmin): permite LOAD DATA LOCAL INFILE
[mysql]
local-infile            = 1
